# ---------------------------------------------------------------
# StrongProxy environment. Copy to .env (local) or paste into Coolify.
# NEVER commit real values. Provider keys live ONLY here, never in the DB.
# ---------------------------------------------------------------

# Public URL of the site (used for payment callbacks and emails)
NEXT_PUBLIC_SITE_URL=https://strongproxy.example.com
NEXT_PUBLIC_SITE_NAME=StrongProxy
# Support email shown on the site and in Terms
NEXT_PUBLIC_SUPPORT_EMAIL=support@strongproxy.example.com

# --- Supabase (Settings -> API in your self-hosted Supabase / Coolify service) ---
NEXT_PUBLIC_SUPABASE_URL=https://supabase.strongproxy.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that get admin access (in addition to profiles.role = 'admin')
ADMIN_EMAILS=you@example.com

# --- Paystack (Dashboard -> Settings -> API Keys & Webhooks) ---
# Webhook URL to paste in Paystack: https://YOUR_DOMAIN/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_ENABLED=true

# --- NOWPayments (crypto / USDT) ---
# IPN callback URL is sent per invoice automatically: https://YOUR_DOMAIN/api/webhooks/nowpayments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Optional: force a coin on the invoice page, e.g. usdttrc20 (cheapest network fees). Empty = customer picks.
NOWPAYMENTS_PAY_CURRENCY=usdttrc20
# Set to true to use the NOWPayments sandbox (api-sandbox.nowpayments.io)
NOWPAYMENTS_SANDBOX=false

# --- Proxies.sx (DEFAULT provider for Mobile + Residential; no reseller deposit) ---
# Every paid order is delivered instantly through the product's provider (chosen per product in Admin).
# Without these two, products set to Proxies.sx can't be bought (customers are told; nothing is charged).
# Reseller API key (client.proxies.sx; see https://www.proxies.sx/reseller-docs Step 1). Sent as X-API-Key.
PROXIES_SX_API_KEY=
# Your proxy username, e.g. psx_abc123 (shown in client.proxies.sx). Customer usernames are built from it.
PROXIES_SX_PROXY_USERNAME=
# Gateway host shown to customers
PROXIES_SX_GATEWAY_HOST=gw.proxies.sx
# Optional: days until a customer key expires. Empty = bought GB never expires (recommended).
PROXIES_SX_KEY_EXPIRY_DAYS=
# Testing only: point the adapter at a mock server. Leave empty in production.
PROXIES_SX_API_BASE=
# Daily ports use the same PROXIES_SX_API_KEY (give it ports:* and billing:read scopes too).
# Optional: secret for the Proxies.sx webhook (POST /reseller/webhooks { secret }); verifies X-Webhook-Signature.
PROXIES_SX_WEBHOOK_SECRET=

# --- DataImpulse reseller API (optional alternative provider, per product) ---
# Dashboard login + password used by POST /reseller/user/token/get
DATAIMPULSE_LOGIN=
DATAIMPULSE_PASSWORD=
# Proxy gateway host shown to customers. Use your white-label host if you set one up.
DATAIMPULSE_PROXY_HOST=gw.dataimpulse.com
# Threads per created sub-user (max 2000 per DataImpulse docs)
DATAIMPULSE_SUBUSER_THREADS=50
# Testing only: point the adapter at a mock server (see test/e2e/mock-dataimpulse-server.mjs). Leave empty in production.
DATAIMPULSE_API_BASE=

# --- Admin notifications (all optional) ---
# Telegram: create a bot with @BotFather, send it a message, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (preferred) ...
RESEND_API_KEY=
# ... or via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From/To for admin emails
NOTIFY_EMAIL_FROM=StrongProxy <alerts@strongproxy.example.com>
ADMIN_NOTIFY_EMAIL=you@example.com
